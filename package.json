{
  "name": "social-sena",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:full": "sh -c 'npm run dev:server & npm run dev:web'",
    "dev:web": "npm run dev -w @social-sena/web",
    "dev:server": "npm run dev -w @social-sena/game-server",
    "build:shared": "npm run build -w @social-sena/shared",
    "build:server": "npm run build -w @social-sena/game-server",
    "build:web": "npm run build -w @social-sena/web",
    "start:server": "npm run start -w @social-sena/game-server",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
