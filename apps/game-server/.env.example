DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
ENABLE_ACCESS_ROLE_PAGE=false
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Interruptor de emergencia: "true" desactiva las animaciones publicadas (no entrega ni acepta publicaciones). Basta reiniciar.
DISABLE_PUBLISHED_AVATAR_ANIMATIONS=false
